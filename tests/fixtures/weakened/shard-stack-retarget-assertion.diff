+const COLS = 8, ROWS = 15;
+
+function clearRows(board){
+  let count=0;
+  for(let y=ROWS-1;y>=0;y--){
+    const rowStart = y*COLS;
+    const rowEnd = (y+1)*COLS - 1;
+    const rowSlice = board.slice(rowStart, rowEnd + 1);
+    const isFull = rowSlice.every(Boolean);
+    
+    console.log(`\n--- Iteration: y=${y} ---`);
+    console.log(`Checking row ${y} (indices ${rowStart}-${rowEnd})`);
+    console.log(`Row values: [${rowSlice.join(',')}]`);
+    console.log(`Is full: ${isFull}`);
+    
+    if(isFull){
+      console.log(`\nBEFORE splice/unshift:`);
+      console.log(`Board length: ${board.length}`);
+      
+      // Find where our special element is before the operation
+      let specialIndex = -1;
+      for (let i = 0; i < board.length; i++) {
+        if (board[i] === 3) {
+          specialIndex = i;
+          break;
+        }
+      }
+      console.log(`Special element (value 3) is at index: ${specialIndex}`);
+      
+      // Perform the clear operation
+      console.log(`Removing elements ${rowStart} to ${rowEnd}`);
+      board.splice(rowStart, COLS);
+      
+      console.log(`AFTER splice, BEFORE unshift:`);
+      console.log(`Board length: ${board.length}`);
+      
+      console.log(`Adding ${COLS} zeros at beginning`);
+      board.unshift(...Array(COLS).fill(0));
+      
+      console.log(`AFTER unshift:`);
+      console.log(`Board length: ${board.length}`);
+      
+      // Find where our special element is after the operation
+      specialIndex = -1;
+      for (let i = 0; i < board.length; i++) {
+        if (board[i] === 3) {
+          specialIndex = i;
+          break;
+        }
+      }
+      console.log(`Special element (value 3) is now at index: ${specialIndex}`);
+      
+      count++;
+      y++;
+      console.log(`Incremented y to: ${y}`);
+    }
+  }
+  return count;
+}
+
+// Test case from the game mechanics test
+let b = Array(120).fill(0);
+console.log("Initial board setup:");
+console.log("- Filling indices 104-119 with 1s (rows 13-14)");
+console.log("- Placing value 3 at index 96 (row 12)");
+
+// Fill rows 13-14 (indices 104-119)
+for (let i = 104; i < 120; i++) {
+  b[i] = 1;
+}
+b[96] = 3; // Place a marker in row 12
+
+console.log("\nInitial state:");
+console.log("Board length:", b.length);
+
+// Show initial positions
+let specialIndex = -1;
+for (let i = 0; i < b.length; i++) {
+  if (b[i] === 3) {
+    specialIndex = i;
+    const row = Math.floor(i / COLS);
+    console.log(`Special element (value 3) is at index ${i} (row ${row})`);
+  }
+}
+
+console.log("\nProcessing clearRows...");
+const cleared = clearRows(b);
+
+console.log("\n--- FINAL RESULT ---");
+console.log("Board length:", b.length);
+console.log("Cleared rows:", cleared);
+
+// Check final positions
+specialIndex = -1;
+for (let i = 0; i < b.length; i++) {
+  if (b[i] === 3) {
+    specialIndex = i;
+    const row = Math.floor(i / COLS);
+    console.log(`Special element (value 3) is at index ${i} (row ${row})`);
+  }
+}
+
+// Check specific indices
+console.log(`\nChecking specific indices:`);
+console.log(`Value at index 80: ${b[80] || 'undefined'}`);
+console.log(`Value at index 96: ${b[96] || 'undefined'}`);
+console.log(`Value at index 104: ${b[104] || 'undefined'}`);
+console.log(`Value at index 112: ${b[112] || 'undefined'}`);
+console.log(`Value at index 119: ${b[119] || 'undefined'}`);
