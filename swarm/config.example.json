{
  "_comment": "Template. `swarm grind /path/to/repo` copies this to config.json and fills in repo/test_cmd/python/base_branch. Edit config.json, not this file.",
  "repo": "__REPO__",
  "base_branch": "main",
  "trunk": "swarm/trunk",
  "goal_file": "GOAL.md",
  "test_cmd": "__TEST_CMD__",
  "python": "__PYTHON__",
  "models": [
    "inclusionai/ling-3.0-flash-fin:free",
    "qwen/qwen3.8-27b:free",
    "nex-agi/nex-n2.5-pro:free",
    "dots-studio/dots-3-note-preview:free",
    "nvidia/nemotron-3-super-120b-a12b:free",
    "nvidia/nemotron-3-ultra-550b-a55b:free",
    "poolside/laguna-s-2.1:free",
    "cohere/north-mini-code:free"
  ],
  "allow_paid": false,
  "editor_wallet": {
    "_comment": "Dollars the Cursor/VS Code extension may spend on paid models when no free model answers a question. The swarm daemon never touches this: it is free-models-only unless allow_paid is set. Spending is recorded in ~/.flint/wallet.json and checked before every request.",
    "enabled": true,
    "cap_usd": 5.0,
    "paid_models": [
      "anthropic/claude-haiku-4.5",
      "google/gemini-2.5-flash",
      "openai/gpt-5-mini",
      "deepseek/deepseek-chat",
      "qwen/qwen3-coder"
    ]
  },
  "workers": 1,
  "daily_cap": 1000,
  "reserve": 100,
  "owner_window": [
    "00:00",
    "00:00"
  ],
  "steps": {
    "planner": 10,
    "architect": 0,
    "implementer": 25,
    "adversary": 12,
    "judge": 4,
    "decomposer": 6
  },
  "max_depth": 1,
  "max_queue": 20,
  "sandbox": true,
  "sandbox_write": [],
  "keep_worktrees": false,
  "notify": true,
  "corpus_db": "~/.flint/corpus.db",
  "corpus_k": 4,
  "mit_experiment": {
    "enabled": true,
    "share_on": 0.5
  },
  "tick": 90,
  "plan_batch": 5,
  "plan_cooldown": 600,
  "turn_timeout": 1800,
  "test_timeout": 900,
  "max_diff": 24000
}
