# Required for live generation. Without it the studio automatically uses offline demo output.
OPENROUTER_API_KEY=sk-or-v1-...

# Cost-conscious defaults; replace with any compatible current model slug.
INFLUENCER_IMAGE_MODEL=openai/gpt-image-1-mini
INFLUENCER_CHAT_MODEL=openrouter/free

# Set to 1 to force deterministic local previews even when a key is present.
INFLUENCER_MOCK=0
PORT=8787
