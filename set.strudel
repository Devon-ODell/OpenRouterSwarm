// set.strudel — livecoding set, driven by glm-5.3-flash via strudel.nvim
// <leader>ss sends the selection/line to the live browser tab.

// warm-up bar
s(0, [0, 3, 7, 10]).freq(60)
  .clip(1).gain(0.9)
  .add(0.125)
  .lpf(4000)

// beat algorithm — send this once the crowd is moving
s(8*4, [1, 0, 1, 0, 1, 0, 1, 1]).arp(0.125)
  .gain(0.8).hp(200).delay(0.375, 0.4, 0.4)